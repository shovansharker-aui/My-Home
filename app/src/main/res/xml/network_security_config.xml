<?xml version="1.0" encoding="utf-8"?>
<!-- The camera's own web/API server has no TLS, so cleartext HTTP must be
     allowed for its hotspot IP. Scoped narrowly instead of a blanket allow. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.42.1</domain>
    </domain-config>
</network-security-config>
